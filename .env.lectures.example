# Copy the needed lines to .env.local (ignored by Git), or set Railway variables.
# Get a real connection URL from the NEW lecture database. Never paste it into chat or source.
LECTURES_DATABASE_URL=
# Local preview; replace with the real HTTPS site origin in production.
LECTURES_APP_ORIGIN=http://127.0.0.1:3100
# Set only for first-owner bootstrap; remove these after success.
LECTURES_BOOTSTRAP_USERNAME=
LECTURES_BOOTSTRAP_NAME=
LECTURES_BOOTSTRAP_PASSWORD=

# Enable only after the separate worker is configured. Match this token on both services.
LECTURES_WORKER_ENABLED=false
LECTURES_WORKER_TOKEN=
