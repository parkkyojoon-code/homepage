# Separate schema only; no fallback to LECTURES_DATABASE_URL or DATABASE_URL.
DAECHION_DATABASE_URL=
DAECHION_BILLING_WORKER_ENABLED=false
DAECHION_BILLING_SEND_ENABLED=false
DAECHION_PAYMENT_READ_ENABLED=false
DAECHION_ENROLLMENT_ENABLED=false
# Read-only administrator session maintenance; never starts the financial cycle.
DAECHION_SESSION_MAINTENANCE_ENABLED=false
DAECHION_BROWSER_CHECK_LECTURE_ID=
DAECHION_CONTENT_BROWSER_ENABLED=false
DAECHION_CONTENT_BROWSER_VERIFIED=false
# Private bootstrap only; refreshed state is encrypted in browser_sessions.
DAECHION_BROWSER_STORAGE_STATE=
# Enable only after real API testing covers student, both guardian fields and inactive records.
DAECHION_IDENTITY_LOOKUP_VERIFIED=false
# Enrollment alone does not prove access to existing videos/materials.
# Keep false until actual post-registration file access is verified.
DAECHION_ACCESS_POLICY_VERIFIED=false
DAECHION_API_KEY=
# Exact tenant ID obtained during an authorized read-only /v1/me verification.
DAECHION_TENANT_ID=
DAECHION_SHEETS_ENABLED=false
DAECHION_READY_MESSAGE_ENABLED=false
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER=
DAECHION_SHEETS_SPREADSHEET_ID=
DAECHION_SHEETS_SHEET_ID=
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
PAYSSAM_API_KEY=
PAYSSAM_MEMBER=
PAYSSAM_MERCHANT=
# Required HTTPS callback for process 2. Do not use the retired /api/lectures path.
# Set to the deployed web origin + /api/daechion/payssam/notification only after
# enabling its authenticated receipt handler. Payment is independently polled.
DAECHION_BILLING_CALLBACK_URL=
